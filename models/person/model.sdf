<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="person">
    <!-- pose spawn komutunda override edilecek -->

    <!-- ===== BACAK SOL (r=0.07m, h=0.6m, merkez z=0.3m) ===== -->
    <link name="leg_left_link">
      <pose>0.0 0.1 0.3 0 0 0</pose>
      <inertial><mass>5</mass><inertia><ixx>0.1</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.1</iyy><iyz>0</iyz><izz>0.02</izz></inertia></inertial>
      <collision name="col"><geometry><cylinder><radius>0.07</radius><length>0.6</length></cylinder></geometry></collision>
      <visual name="vis">
        <geometry><cylinder><radius>0.07</radius><length>0.6</length></cylinder></geometry>
        <material><ambient>0.25 0.25 0.55 1</ambient><diffuse>0.25 0.25 0.55 1</diffuse></material>
      </visual>
    </link>
    <joint name="leg_left_joint" type="fixed">
      <parent>body_link</parent><child>leg_left_link</child>
    </joint>

    <!-- ===== BACAK SAĞ ===== -->
    <link name="leg_right_link">
      <pose>0.0 -0.1 0.3 0 0 0</pose>
      <inertial><mass>5</mass><inertia><ixx>0.1</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.1</iyy><iyz>0</iyz><izz>0.02</izz></inertia></inertial>
      <collision name="col"><geometry><cylinder><radius>0.07</radius><length>0.6</length></cylinder></geometry></collision>
      <visual name="vis">
        <geometry><cylinder><radius>0.07</radius><length>0.6</length></cylinder></geometry>
        <material><ambient>0.25 0.25 0.55 1</ambient><diffuse>0.25 0.25 0.55 1</diffuse></material>
      </visual>
    </link>
    <joint name="leg_right_joint" type="fixed">
      <parent>body_link</parent><child>leg_right_link</child>
    </joint>

    <!-- ===== GÖVDE (silindir: r=0.2m, h=0.75m, merkez z=0.975m) ===== -->
    <link name="body_link">
      <pose>0 0 0.975 0 0 0</pose>
      <inertial>
        <mass>55</mass>
        <inertia><ixx>5</ixx><ixy>0</ixy><ixz>0</ixz><iyy>5</iyy><iyz>0</iyz><izz>1.1</izz></inertia>
      </inertial>
      <collision name="body_col">
        <geometry><cylinder><radius>0.2</radius><length>0.75</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="body_vis">
        <geometry><cylinder><radius>0.2</radius><length>0.75</length></cylinder></geometry>
        <!-- Koyu lacivert gömlek -->
        <material><ambient>0.15 0.2 0.5 1</ambient><diffuse>0.15 0.2 0.5 1</diffuse></material>
      </visual>
    </link>

    <!-- ===== KOL SOL ===== -->
    <link name="arm_left_link">
      <pose>0.0 0.26 1.0 0 0 0</pose>
      <inertial><mass>2</mass><inertia><ixx>0.03</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.03</iyy><iyz>0</iyz><izz>0.005</izz></inertia></inertial>
      <collision name="col"><geometry><cylinder><radius>0.055</radius><length>0.55</length></cylinder></geometry></collision>
      <visual name="vis">
        <geometry><cylinder><radius>0.055</radius><length>0.55</length></cylinder></geometry>
        <material><ambient>0.15 0.2 0.5 1</ambient><diffuse>0.15 0.2 0.5 1</diffuse></material>
      </visual>
    </link>
    <joint name="arm_left_joint" type="fixed">
      <parent>body_link</parent><child>arm_left_link</child>
    </joint>

    <!-- ===== KOL SAĞ ===== -->
    <link name="arm_right_link">
      <pose>0.0 -0.26 1.0 0 0 0</pose>
      <inertial><mass>2</mass><inertia><ixx>0.03</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.03</iyy><iyz>0</iyz><izz>0.005</izz></inertia></inertial>
      <collision name="col"><geometry><cylinder><radius>0.055</radius><length>0.55</length></cylinder></geometry></collision>
      <visual name="vis">
        <geometry><cylinder><radius>0.055</radius><length>0.55</length></cylinder></geometry>
        <material><ambient>0.15 0.2 0.5 1</ambient><diffuse>0.15 0.2 0.5 1</diffuse></material>
      </visual>
    </link>
    <joint name="arm_right_joint" type="fixed">
      <parent>body_link</parent><child>arm_right_link</child>
    </joint>

    <!-- ===== BAŞ (küre: r=0.12m, merkez z=1.48m) ===== -->
    <link name="head_link">
      <pose>0 0 1.48 0 0 0</pose>
      <inertial>
        <mass>5</mass>
        <inertia><ixx>0.029</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.029</iyy><iyz>0</iyz><izz>0.029</izz></inertia>
      </inertial>
      <collision name="head_col">
        <geometry><sphere><radius>0.12</radius></sphere></geometry>
      </collision>
      <visual name="head_vis">
        <geometry><sphere><radius>0.12</radius></sphere></geometry>
        <!-- Ten rengi -->
        <material><ambient>0.88 0.72 0.57 1</ambient><diffuse>0.88 0.72 0.57 1</diffuse></material>
      </visual>

      <!-- ===== BİRİNCİ ŞAHIS KAMERA (z=1.6m, geriye bakan) ===== -->
      <sensor name="rear_cam" type="camera">
        <pose>0 0 0.14 0 0 3.14159</pose>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <camera>
          <horizontal_fov>1.5708</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>R8G8B8</format>
          </image>
          <clip><near>0.05</near><far>30</far></clip>
        </camera>
        <plugin name="rear_cam_plugin" filename="libgazebo_ros_camera.so">
          <ros><namespace>/person</namespace></ros>
          <camera_name>rear_cam</camera_name>
          <frame_name>person_rear_cam_frame</frame_name>
        </plugin>
      </sensor>
    </link>

    <joint name="head_joint" type="fixed">
      <parent>body_link</parent><child>head_link</child>
    </joint>

    <!-- ===== PLANAR HAREKET PLUGİN ===== -->
    <plugin name="planar_move" filename="libgazebo_ros_planar_move.so">
      <ros>
        <namespace>/person</namespace>
        <remapping>cmd_vel:=cmd_vel</remapping>
      </ros>
      <update_rate>100</update_rate>
    </plugin>

    <!-- ===== GROUND-TRUTH ODOM (p3d) ===== -->
    <plugin name="person_p3d" filename="libgazebo_ros_p3d.so">
      <ros>
        <namespace>/person</namespace>
        <remapping>odom:=odom</remapping>
      </ros>
      <body_name>body_link</body_name>
      <frame_name>world</frame_name>
      <update_rate>50</update_rate>
      <xyz_offset>0 0 0</xyz_offset>
      <rpy_offset>0 0 0</rpy_offset>
    </plugin>

  </model>
</sdf>

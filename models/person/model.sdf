<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="person">
    <!-- pose spawn komutunda override edilecek -->

    <!-- ===== GÖVDE (silindir: r=0.225m, h=1.4m, merkez z=0.7m) ===== -->
    <link name="body_link">
      <pose>0 0 0.7 0 0 0</pose>

      <inertial>
        <mass>70</mass>
        <inertia>
          <ixx>13.6</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>13.6</iyy><iyz>0</iyz>
          <izz>1.77</izz>
        </inertia>
      </inertial>

      <collision name="body_col">
        <geometry>
          <cylinder><radius>0.225</radius><length>1.4</length></cylinder>
        </geometry>
        <surface>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
        </surface>
      </collision>

      <visual name="body_vis">
        <geometry>
          <cylinder><radius>0.225</radius><length>1.4</length></cylinder>
        </geometry>
        <material>
          <ambient>0.3 0.4 0.8 1</ambient>
          <diffuse>0.3 0.4 0.8 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- ===== BAŞ (küre: r=0.12m, merkez z=1.46m) ===== -->
    <link name="head_link">
      <pose>0 0 1.46 0 0 0</pose>

      <inertial>
        <mass>5</mass>
        <inertia>
          <ixx>0.0288</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0288</iyy><iyz>0</iyz>
          <izz>0.0288</izz>
        </inertia>
      </inertial>

      <collision name="head_col">
        <geometry><sphere><radius>0.12</radius></sphere></geometry>
      </collision>

      <visual name="head_vis">
        <geometry><sphere><radius>0.12</radius></sphere></geometry>
        <material>
          <ambient>0.9 0.75 0.6 1</ambient>
          <diffuse>0.9 0.75 0.6 1</diffuse>
        </material>
      </visual>

      <!-- ===== BİRİNCİ ŞAHIS KAMERA (z=1.6m, geriye bakan, yaw=pi) ===== -->
      <sensor name="rear_cam" type="camera">
        <pose>0 0 0.14 0 0 3.14159</pose>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <camera>
          <horizontal_fov>1.5708</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>30</far>
          </clip>
        </camera>
        <plugin name="rear_cam_plugin" filename="libgazebo_ros_camera.so">
          <ros>
            <namespace>/person</namespace>
          </ros>
          <camera_name>rear_cam</camera_name>
          <frame_name>person_rear_cam_frame</frame_name>
        </plugin>
      </sensor>
    </link>

    <!-- Baş-gövde eklem (sabit) -->
    <joint name="head_joint" type="fixed">
      <parent>body_link</parent>
      <child>head_link</child>
    </joint>

    <!-- ===== PLANAR HAREKET PLUGİN ===== -->
    <plugin name="planar_move" filename="libgazebo_ros_planar_move.so">
      <ros>
        <namespace>/person</namespace>
        <remapping>cmd_vel:=cmd_vel</remapping>
      </ros>
      <update_rate>100</update_rate>
    </plugin>

    <!-- ===== GROUND-TRUTH ODOM (p3d) ===== -->
    <plugin name="person_p3d" filename="libgazebo_ros_p3d.so">
      <ros>
        <namespace>/person</namespace>
        <remapping>odom:=odom</remapping>
      </ros>
      <body_name>body_link</body_name>
      <frame_name>world</frame_name>
      <update_rate>50</update_rate>
      <xyz_offset>0 0 0</xyz_offset>
      <rpy_offset>0 0 0</rpy_offset>
    </plugin>

  </model>
</sdf>

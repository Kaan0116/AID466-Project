<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="corridor">

    <!-- Deterministic fizik -->
    <physics type="ode">
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <precon_iters>0</precon_iters>
          <sor>1.4</sor>
        </solver>
        <constraints>
          <cfm>1e-5</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>2000</contact_max_correcting_vel>
          <contact_surface_layer>0.01</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- Yerçekimi -->
    <gravity>0 0 -9.81</gravity>

    <!-- Arka plan rengi (gri ton) -->
    <scene>
      <ambient>0.35 0.35 0.35 1</ambient>
      <background>0.4 0.4 0.4 1</background>
      <shadows>false</shadows>
      <sky>
        <clouds>
          <speed>0</speed>
        </clouds>
      </sky>
    </scene>

    <!-- GUI kamera -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <!-- Koridor girişinde, göz hizasında, içeri bakıyor -->
        <pose>-1 0 1.6 0 0.05 0</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

    <!-- ===================== KORIDOR GEOMETRİSİ ===================== -->
    <!-- 30m uzun (+x), 2.4m geniş (y), 2.8m yüksek (z) -->
    <!-- Merkez: x=15, y=0, z=1.4 -->

    <!-- ZEMİN -->
    <model name="floor">
      <static>true</static>
      <pose>15 0 0 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>30 2.4 0.02</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>30 2.4 0.02</size></box></geometry>
          <material>
            <ambient>0.45 0.45 0.45 1</ambient>
            <diffuse>0.45 0.45 0.45 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- TAVAN -->
    <model name="ceiling">
      <static>true</static>
      <pose>15 0 2.8 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>30 2.4 0.02</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>30 2.4 0.02</size></box></geometry>
          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.85 0.85 0.85 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- SOL DUVAR (y = +1.2) -->
    <model name="wall_left">
      <static>true</static>
      <pose>15 1.2 1.4 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>30 0.02 2.8</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>30 0.02 2.8</size></box></geometry>
          <material>
            <ambient>0.80 0.80 0.80 1</ambient>
            <diffuse>0.80 0.80 0.80 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- SAĞ DUVAR (y = -1.2) -->
    <model name="wall_right">
      <static>true</static>
      <pose>15 -1.2 1.4 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>30 0.02 2.8</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>30 0.02 2.8</size></box></geometry>
          <material>
            <ambient>0.80 0.80 0.80 1</ambient>
            <diffuse>0.80 0.80 0.80 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ARKA DUVAR (x = 0) -->
    <model name="wall_back">
      <static>true</static>
      <pose>0 0 1.4 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.02 2.4 2.8</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.02 2.4 2.8</size></box></geometry>
          <material>
            <ambient>0.80 0.80 0.80 1</ambient>
            <diffuse>0.80 0.80 0.80 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ÖN DUVAR (x = 30) -->
    <model name="wall_front">
      <static>true</static>
      <pose>30 0 1.4 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.02 2.4 2.8</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.02 2.4 2.8</size></box></geometry>
          <material>
            <ambient>0.80 0.80 0.80 1</ambient>
            <diffuse>0.80 0.80 0.80 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===================== TAVAN IŞIKLARI ===================== -->
    <!-- 6 adet, x = 2.5, 7.5, 12.5, 17.5, 22.5, 27.5 -->

    <light name="ceiling_light_1" type="point">
      <pose>2.5 0 2.7 0 0 0</pose>
      <diffuse>0.65 0.65 0.65 1</diffuse>
      <specular>0.05 0.05 0.05 1</specular>
      <attenuation>
        <range>7</range>
        <constant>0.8</constant>
        <linear>0.1</linear>
        <quadratic>0.005</quadratic>
      </attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <light name="ceiling_light_2" type="point">
      <pose>7.5 0 2.7 0 0 0</pose>
      <diffuse>0.65 0.65 0.65 1</diffuse>
      <specular>0.05 0.05 0.05 1</specular>
      <attenuation>
        <range>7</range>
        <constant>0.8</constant>
        <linear>0.1</linear>
        <quadratic>0.005</quadratic>
      </attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <light name="ceiling_light_3" type="point">
      <pose>12.5 0 2.7 0 0 0</pose>
      <diffuse>0.65 0.65 0.65 1</diffuse>
      <specular>0.05 0.05 0.05 1</specular>
      <attenuation>
        <range>7</range>
        <constant>0.8</constant>
        <linear>0.1</linear>
        <quadratic>0.005</quadratic>
      </attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <light name="ceiling_light_4" type="point">
      <pose>17.5 0 2.7 0 0 0</pose>
      <diffuse>0.65 0.65 0.65 1</diffuse>
      <specular>0.05 0.05 0.05 1</specular>
      <attenuation>
        <range>7</range>
        <constant>0.8</constant>
        <linear>0.1</linear>
        <quadratic>0.005</quadratic>
      </attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <light name="ceiling_light_5" type="point">
      <pose>22.5 0 2.7 0 0 0</pose>
      <diffuse>0.65 0.65 0.65 1</diffuse>
      <specular>0.05 0.05 0.05 1</specular>
      <attenuation>
        <range>7</range>
        <constant>0.8</constant>
        <linear>0.1</linear>
        <quadratic>0.005</quadratic>
      </attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <light name="ceiling_light_6" type="point">
      <pose>27.5 0 2.7 0 0 0</pose>
      <diffuse>0.65 0.65 0.65 1</diffuse>
      <specular>0.05 0.05 0.05 1</specular>
      <attenuation>
        <range>7</range>
        <constant>0.8</constant>
        <linear>0.1</linear>
        <quadratic>0.005</quadratic>
      </attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <!-- ===================== ÜÇÜNCÜ ŞAHIS GENEL BAKIŞ KAMERASI ===================== -->
    <!-- Koridorun solunda üst köşe; +x yönüne bakıyor, biraz aşağı eğilmiş.
         pitch=+0.3 → +x ve biraz -z (zemine doğru).
         yaw=-0.25 → hafifçe sağa (koridor merkezi y=0'a doğru). -->
    <model name="overview_camera_model">
      <static>true</static>
      <pose>5 1.1 2.5 0 0.3 -0.25</pose>
      <link name="link">
        <sensor name="overview_cam" type="camera">
          <always_on>true</always_on>
          <update_rate>30</update_rate>
          <camera>
            <horizontal_fov>1.7453</horizontal_fov>
            <image>
              <width>1280</width>
              <height>720</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>40</far>
            </clip>
          </camera>
          <plugin name="overview_cam_plugin" filename="libgazebo_ros_camera.so">
            <ros>
              <namespace></namespace>
            </ros>
            <camera_name>overview_cam</camera_name>
            <frame_name>overview_cam_frame</frame_name>
          </plugin>
        </sensor>
      </link>
    </model>

  </world>
</sdf>
